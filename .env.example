# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LBank Read-Only API Integration (HmacSHA256)
LBANK_API_KEY="c4bf07aa-cc79-47a3-b74e-eb4a27ab28b1"
LBANK_SECRET_KEY="9C7AD141BAB47C632F3DB481EE00AE81"
LBANK_BASE_URL="https://api.lbank.info"

# LBank USDT Deposit Address on TRON (TRC20)
# Configure your destination TRC20 address here:
LBANK_USDT_TRC20_ADDRESS="TYDzsYUEpvnYmQk4zGP9sWWcTEd36AmyWP"

# Google PageSpeed Insights API Key (Server-side only)
# Required for production deployments to avoid shared cloud egress IP quota limits.
# Primary variable: PAGESPEED_API_KEY
# Compatible fallback: GOOGLE_API_KEY
# Security: Server reads this exclusively in server/pagespeed.ts; NEVER exposed to the frontend/browser.
# Deployment: In Cloud Run, GCP Console, or Docker, configure PAGESPEED_API_KEY in the Environment Variables section.
# A container restart/redeployment is required after setting or updating this variable.
PAGESPEED_API_KEY=""
GOOGLE_API_KEY=""

# PostgreSQL Production Database Configuration
# Standard connection string for PostgreSQL (e.g. Cloud SQL, Neon, Supabase, RDS)
DATABASE_URL="postgresql://username:password@localhost:5432/pulsevanguard"
# SSL configuration for managed PostgreSQL providers (true/false)
DATABASE_SSL="true"
# Whether to reject unauthorized certificates (set to false for self-signed certificates)
DATABASE_SSL_REJECT_UNAUTHORIZED="true"
# PostgreSQL connection pool settings
DATABASE_MAX_POOL="20"
DATABASE_TIMEOUT_MS="10000"
