# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PUBLIC_APP_URL / APP_URL: The canonical public URL where this application is hosted.
# Used for referral links, password reset links, and strict CORS / Origin validation.
PUBLIC_APP_URL="https://your-domain.example.com"
APP_URL="https://your-domain.example.com"

# Security & Authentication Secrets (Required in production: >= 32 random characters)
SECURITY_PEPPER="REPLACE_WITH_AT_LEAST_32_CHARS_OF_RANDOM_HEX_SECRET"
SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_CHARS_OF_RANDOM_HEX_SECRET"
TRUST_PROXY="true"
CORS_ALLOWED_ORIGINS="https://your-domain.example.com"

# LBank Read-Only API Integration (HmacSHA256 — Server-side only, never expose to client)
LBANK_API_KEY="YOUR_LBANK_API_KEY"
LBANK_SECRET_KEY="YOUR_LBANK_SECRET_KEY"
LBANK_BASE_URL="https://api.lbank.info"

# LBank USDT Deposit Address on TRON (TRC20)
LBANK_USDT_TRC20_ADDRESS="TYDzsYUEpvnYmQk4zGP9sWWcTEd36AmyWP"

# Google PageSpeed Insights API Key (Server-side only)
# Required for production deployments to avoid shared cloud egress IP quota limits.
# Primary variable: PAGESPEED_API_KEY
# Compatible fallback: GOOGLE_API_KEY
# Security: Server reads this exclusively in server/pagespeed.ts; NEVER exposed to the frontend/browser.
# Deployment: Set PAGESPEED_API_KEY (or GOOGLE_API_KEY) in /etc/pulsevanguard/pulsevanguard.env (or Cloud Run/Docker env)
# and restart the service (sudo systemctl restart pulsevanguard.service) or redeploy the container.
PAGESPEED_API_KEY=""
GOOGLE_API_KEY=""

# WHOIS / Domain Registration Lookup Configuration (Server-side only)
# Optional commercial WHOIS API key (e.g., WhoisXMLAPI, IP2WHOIS, WhoisFreaks, API-Ninjas, APILayer, WhoisJSON).
# When WHOIS_API_KEY is omitted, PulseVanguard automatically queries the official IANA RDAP authoritative registries.
# Security: Never expose WHOIS_API_KEY to the frontend/browser.
WHOIS_API_KEY=""
WHOIS_API_PROVIDER=""
WHOIS_API_URL=""

# PostgreSQL Production Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/pulsevanguard"
DATABASE_SSL="true"
DATABASE_SSL_REJECT_UNAUTHORIZED="true"
DATABASE_MAX_POOL="20"
DATABASE_TIMEOUT_MS="10000"
