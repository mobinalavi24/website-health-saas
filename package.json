{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.ts",
    "test": "tsx test-trial.ts && tsx test-advanced-seo.ts && tsx test-postgres.ts && tsx test-pagespeed.ts && tsx test-auth-and-payments.ts && tsx test-referrals.ts && tsx test-subscription-stacking.ts",
    "test:trial": "tsx test-trial.ts",
    "test:seo": "tsx test-advanced-seo.ts",
    "test:postgres": "tsx test-postgres.ts",
    "test:pagespeed": "tsx test-pagespeed.ts",
    "test:auth-payments": "tsx test-auth-and-payments.ts",
    "test:referrals": "tsx test-referrals.ts",
    "test:stacking": "tsx test-subscription-stacking.ts",
    "db:migrate": "tsx -e \"import { runMigration } from './server/db/migrate.ts'; runMigration().then(console.log);\"",
    "db:verify": "tsx -e \"import { verifyMigration } from './server/db/verify.ts'; verifyMigration().then(r => console.log(JSON.stringify(r, null, 2)));\"",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
